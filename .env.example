# Planner mode. "offline" needs no API key and is fully deterministic.
# For a real model use "<provider>:<model>", for example:
#   TRIAGE_LLM=openai:gpt-4o-mini      (needs OPENAI_API_KEY and pip install -e ".[llm]")
#   TRIAGE_LLM=anthropic:claude-sonnet-4-5  (needs ANTHROPIC_API_KEY)
TRIAGE_LLM=offline

# Where incidents and run traces are written
TRIAGE_DB=var/incidents.db
TRIAGE_RUNS_DIR=runs
