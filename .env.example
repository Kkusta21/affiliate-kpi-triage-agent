# Reference list of the environment variables the agent reads.
# The app does not load this file by itself: export the variables in your shell.

# Planner mode. "offline" needs no API key and is fully deterministic.
# For a real model use "<provider>:<model>" and pip install -e ".[llm]", for example:
#   TRIAGE_LLM=openai:gpt-4o-mini            (needs OPENAI_API_KEY)
#   TRIAGE_LLM=anthropic:claude-haiku-4-5    (needs ANTHROPIC_API_KEY)
TRIAGE_LLM=offline

# Optional. No temperature is sent unless this is set, because some models reject it.
# TRIAGE_LLM_TEMPERATURE=0

# Landing page probe. "fixture" (default) is a mock. "http" sends real, read-only HTTP requests,
# and only to the hosts listed here. Private and link-local addresses are always refused.
TRIAGE_PAGE_PROBE=fixture
# TRIAGE_PAGE_ALLOWED_HOSTS=lp.example.com,www.example.com
# TRIAGE_PAGE_TIMEOUT_SECONDS=5
# TRIAGE_PAGE_MAX_BYTES=512000
# TRIAGE_PAGE_PIXEL_MARKER=data-tracking-pixel

# API authorization. When set, every data endpoint needs the header "X-API-Key: <value>".
# TRIAGE_API_KEY=change-me

# Business thresholds (defaults shown). See src/triage_agent/config.py for the full list.
# TRIAGE_MIN_CLICKS_FOR_SIGNAL=100
# TRIAGE_DROP_THRESHOLD_PCT=-30
# TRIAGE_Z_THRESHOLD=2.58
# TRIAGE_SPIKE_THRESHOLD_PCT=100
# TRIAGE_BOT_SCORE_THRESHOLD=0.7
# TRIAGE_BAD_SOURCE_SHARE_THRESHOLD=0.3
# TRIAGE_DISALLOWED_GEO_SHARE_THRESHOLD=0.3
# TRIAGE_POSTBACK_RATIO_THRESHOLD=0.5
# TRIAGE_PAGE_LATENCY_LIMIT_MS=10000

# Where incidents and run traces are written
TRIAGE_DB=var/incidents.db
TRIAGE_RUNS_DIR=runs
